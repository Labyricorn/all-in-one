{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mgmv:correction:1",
  "title": "MGMV correction transaction",
  "type": "object",
  "required": ["schema_version", "project_id", "base_revision", "base_analysis_sha256", "transaction_id"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "base_revision": {"type": "integer", "minimum": 0},
    "base_analysis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transaction_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "metadata": {"type": "object"},
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "required": ["op"],
        "properties": {
          "op": {"enum": ["insert_word", "delete_word", "replace_word", "set_word_interval", "insert_line", "delete_line", "replace_line", "set_line_interval", "split_line", "merge_lines", "insert_beat", "delete_beat", "set_beat", "transform_grid", "insert_section", "delete_section", "set_section", "set_section_interval", "insert_event", "delete_event", "set_event", "set_event_interval", "mark_riff", "set_tags"]},
          "id": {"type": "string", "minLength": 1},
          "word_id": {"type": "string", "minLength": 1},
          "line_id": {"type": "string", "minLength": 1},
          "beat_id": {"type": "string", "minLength": 1},
          "section_id": {"type": "string", "minLength": 1},
          "event_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["word", "line", "beat", "section", "event"]},
          "after_id": {"type": ["string", "null"]},
          "other_line_id": {"type": "string", "minLength": 1},
          "word_index": {"type": "integer", "minimum": 1},
          "text": {"type": "string"},
          "start": {"type": ["number", "null"]},
          "end": {"type": ["number", "null"]},
          "time": {"type": "number"},
          "position_in_bar": {"type": "integer", "minimum": 1, "maximum": 4},
          "scale": {"type": "number", "exclusiveMinimum": 0},
          "shift": {"type": "number"},
          "morph_to": {"type": "string"},
          "morph_at": {"type": "number"},
          "value": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  }
}
